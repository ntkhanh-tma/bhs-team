# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit it.

# The .NET 10 API origin (no trailing slash).
#   Local dev:  http://localhost:5199
#   Production: https://<your-app>.azurewebsites.net
# There is NO shared secret any more — the API authenticates each user with a
# JWT, so nothing confidential ships in the browser bundle.
API_BASE_URL=http://localhost:5199

# API Ninjas (https://api-ninjas.com) — daily riddle widget
API_NINJAS_KEY=your_api_ninjas_key_here
